# Переменные окружения — демо-стенд

# Скопируй в .env.local на Vercel Preview / отдельный Supabase-проект

# ─── Supabase (отдельный проект для демо!) ───────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-DEMO-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── Telegram Bot (тестовый бот для демо) ────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456789:ABC...
TELEGRAM_MINI_APP_URL=https://your-demo-app.vercel.app

# ─── Публичный URL ───────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://your-demo-app.vercel.app

# ─── Cron (Vercel автоматически вызывает /api/cron/*) ────────────────────────
CRON_SECRET=random-long-secret-for-demo

# ─── Dev / демо OTP (НЕ включать на production!) ─────────────────────────────
# DENTAL_GATE_DEV_ALLOW=1
# NEXT_PUBLIC_DEMO_OTP_CODES=1234,123456

# ─── Мультитенантность (шаг 11) — slug клиники на этом инстансе ─────────────
NEXT_PUBLIC_CLINIC_SLUG=default
CLINIC_SLUG=default

# ─── AI-помощник (шаг 13) ────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# ─── SaaS / Super Admin (шаг 15) ─────────────────────────────────────────────
# Email или телефон platform admin (fallback без записи в platform_admins)
# PLATFORM_ADMIN_EMAILS=you@company.ru
# PLATFORM_ADMIN_PHONES=79991234567

# Второй demo-тенант: отдельный Vercel preview с CLINIC_SLUG=demo-b
# NEXT_PUBLIC_CLINIC_SLUG=demo-b
